   "source": [
    "def similarity_comparison():\n",
    "    \"\"\"比较不同相似度计算方法\"\"\"\n",
    "    # 创建几个测试向量\n",
    "    vectors = np.array([\n",
    "        [1, 2, 3],      # 向量A\n",
    "        [2, 4, 6],      # 向量B (2倍A)\n",
    "        [1, 1, 1],      # 向量C\n",
    "        [3, 5, 8]       # 向量D\n",
    "    ])\n",
    "    \n",
    "    def euclidean_distance(v1, v2):\n",
    "        return np.sqrt(np.sum((v1 - v2) ** 2))\n",
    "    \n",
    "    def cosine_sim(v1, v2):\n",
    "        return np.dot(v1, v2) / (np.linalg.norm(v1) * np.linalg.norm(v2))\n",
    "    \n",
    "    def dot_product(v1, v2):\n",
    "        return np.dot(v1, v2)\n",
    "    \n",
    "    # 计算相似度矩阵\n",
    "    cosine_matrix = cosine_similarity(vectors)\n",
    "    \n",
    "    # 创建可视化\n",
    "    fig, axes = plt.subplots(2, 2, figsize=(15, 12))\n",
    "    \n",
    "    # 原始向量\n",
    "    ax = axes[0, 0]\n",
    "    ax.scatter(vectors[:, 0], vectors[:, 1], s=100, alpha=0.7)\n",
    "    for i, label in enumerate(['向量A', '向量B(2×A)', '向量C', '向量D']):\n",
    "        ax.annotate(label, (vectors[i, 0], vectors[i, 1]), xytext=(5, 5), \n",
    "                   textcoords='offset points', fontsize=10)\n",
    "    ax.set_xlabel('维度1', fontsize=12)\n",
    "    ax.set_ylabel('维度2', fontsize=12)\n",
    "    ax.set_title('向量在2D空间中的分布', fontsize=14, fontweight='bold')\n",
    "    ax.grid(True, alpha=0.3)\n",
    "    \n",
    "    # 余弦相似度矩阵\n",
    "    ax = axes[0, 1]\n",
    "    im = ax.imshow(cosine_matrix, cmap='RdYlBu', vmin=-1, vmax=1)\n",
    "    plt.colorbar(im, ax=ax, label='余弦相似度')\n",
    "    ax.set_title('余弦相似度矩阵', fontsize=14, fontweight='bold')\n",
    "    ax.set_xticks(range(4))\n",
    "    ax.set_yticks(range(4))\n",
    "    ax.set_xticklabels(['A', 'B', 'C', 'D'])\n",
    "    ax.set_yticklabels(['A', 'B', 'C', 'D'])\n",
    "    \n",
    "    # 添加数值\n",
    "    for i in range(4):\n",
    "        for j in range(4):\n",
    "            ax.text(j, i, f'{cosine_matrix[i][j]:.2f}', ha='center', va='center',\n",
    "                   color='white' if cosine_matrix[i][j] > 0.5 else 'black')\n",
    "    \n",
    "    # 欧氏距离\n",
    "    ax = axes[1, 0]\n",
    "    euclidean_matrix = np.zeros((4, 4))\n",
    "    for i in range(4):\n",
    "        for j in range(4):\n",
    "            euclidean_matrix[i][j] = euclidean_distance(vectors[i], vectors[j])\n",
    "    \n",
    "    im = ax.imshow(euclidean_matrix, cmap='viridis')\n",
    "    plt.colorbar(im, ax=ax, label='欧氏距离')\n",
    "    ax.set_title('欧氏距离矩阵', fontsize=14, fontweight='bold')\n",
    "    ax.set_xticks(range(4))\n",
    "    ax.set_yticks(range(4))\n",
    "    ax.set_xticklabels(['A', 'B', 'C', 'D'])\n",
    "    ax.set_yticklabels(['A', 'B', 'C', 'D'])\n",
    "    \n",
    "    # 向量模长对比\n",
    "    ax = axes[1, 1]\n",
    "    norms = np.linalg.norm(vectors, axis=1)\n",
    "    bars = ax.bar(['A', 'B', 'C', 'D'], norms, color=['red', 'blue', 'green', 'orange'])\n",
    "    ax.set_ylabel('向量模长', fontsize=12)\n",
    "    ax.set_title('各向量的模长', fontsize=14, fontweight='bold')\n",
    "    \n",
    "    # 添加数值标签\n",
    "    for bar, norm in zip(bars, norms):\n",
    "        ax.text(bar.get_x() + bar.get_width()/2., bar.get_height(),\n",
    "                f'{norm:.1f}', ha='center', va='bottom')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    return cosine_matrix\n",
    "\n",
    "print(\"📊 正在比较不同相似度计算方法...\")\n",
    "cosine_matrix = similarity_comparison()\n",
    "print(\"✅ 相似度计算分析完成！\")"
   ]
  },
