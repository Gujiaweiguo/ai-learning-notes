    "# 实践：为糖水店设计问答系统的Embedding策略\n",
    "def restaurant_qa_embedding_strategy():\n",
    "    \"\"\"演示为糖水店设计Embedding策略\"\"\"\n",
    "    \n",
    "    # 糖水店常见问题类型\n",
    "    questions = [\n",
    "        \"你们的杨枝甘露多少钱？\",\n",
    "        \"杨枝甘露的配方是什么？\",\n",
    "        \"有芒果味的甜品吗？\",\n",
    "        \"今天有什么新品推荐？\",\n",
    "        \"附近的门店在哪里？\",\n",
    "        \"营业时间是几点到几点？\",\n",
    "        \"可以外带吗？\",\n",
    "        \"WiFi密码是多少？\",\n",
    "        \"有会员优惠吗？\",\n",
    "        \"需要预约吗？\"\n",
    "    ]\n",
    "    \n",
    "    print(\"🍨 糖水店问题分类分析：\")\n",
    "    print(\"\\n1️⃣ 产品相关：\")\n",
    "    product_questions = [q for q in questions if any(word in q for word in ['价格', '配方', '口味', '产品', '新品'])]\n",
    "    for q in product_questions:\n",
    "        print(f\"  • {q}\")\n",
    "    \n",
    "    print(\"\\n2️⃣ 服务相关：\")\n",
    "    service_questions = [q for q in questions if any(word in q for word in ['营业', '时间', '外带', '预约', 'WiFi', '会员'])]\n",
    "    for q in service_questions:\n",
    "        print(f\"  • {q}\")\n",
    "    \n",
    "    print(\"\\n3️⃣ 地理相关：\")\n",
    "    geo_questions = [q for q in questions if any(word in q for word in ['附近', '门店', '地址', '位置'])]\n",
    "    for q in geo_questions:\n",
    "        print(f\"  • {q}\")\n",
    "    \n",
    "    print(\"\\n💡 Embedding设计建议：\")\n",
    "    print(\"• 选择支持中文的多语言Embedding模型\")\n",
    "    print(\"• 将FAQ文档按类别分组，分别训练专业领域模型\")\n",
    "    print(\"• 产品描述嵌入时包含价格、配料、口味等属性\")\n",
    "    print(\"• 使用地理编码处理位置相关的查询\")\n",
    "    print(\"• 定期更新Embedding以反映新品和促销信息\")\n",
    "    \n",
    "    # 计算问题相似度\n",
    "    model = SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2')\n",
    "    embeddings = model.encode(questions)\n",
    "    similarity_matrix = cosine_similarity(embeddings)\n",
    "    \n",
    "    print(f\"\\n🔍 相似度分析完成！共{len(questions)}个问题，平均相似度: {np.mean(similarity_matrix):.3f}\")\n",
    "    \n",
    "print(\"🍰 糖水店Embedding策略分析：\")\n",
    "restaurant_qa_embedding_strategy()"
   ]
