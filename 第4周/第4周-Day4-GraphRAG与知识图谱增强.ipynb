    "# GraphRAG挑战：实体关系抽取挑战\n",
    "def entity_relation_challenge():\n",
    "    \"\"\"\n",
    "    实体关系抽取挑战：从文本中识别实体和关系\n",
    "    \"\"\"\n",
    "    \n",
    "    print(\"🧩 挑战：实体关系抽取\")\n",
    "    print(\"=\" * 40)\n",
    "    \n",
    "    # 模拟的文本数据\n",
    "    text_data = [\n",
    "        \"椰子是制作椰汁的主要原料。\",\n",
    "        \"椰汁可以作为奶茶的基础原料。\",\n",
    "        \"红豆可以制作红豆沙，红豆沙是糖水的常见成分。\",\n",
    "        \"奶茶和糖水都是冷饮类型。\"\n",
    "    ]\n",
    "    \n",
    "    print(\"📝 原始文本：\")\n",
    "    for i, text in enumerate(text_data, 1):\n",
    "        print(f\"   {i}. {text}\")\n",
    "    \n",
    "    print(\"\\n🎯 任务：识别以下实体和关系\")\n",
    "    print(\"=\" * 40)\n",
    "    \n",
    "    # 实体列表\n",
    "    potential_entities = [\n",
    "        \"椰子\", \"椰汁\", \"红豆\", \"红豆沙\", \"糖水\", \"奶茶\", \"原料\", \"制作\", \"成分\", \"冷饮\"\n",
    "    ]\n",
    "    \n",
    "    print(f\"🔍 候选实体：{potential_entities}\")\n",
    "    \n",
    "    # 挑战：手动提取\n",
    "    print(\"\\n💡 挑战：\")\n",
    "    print(\"1. 从每个句子中识别出实体\")\n",
    "    print(\"2. 识别实体之间的关系类型\")\n",
    "    print(\"3. 构建三元组（实体1，关系，实体2）\")\n",
    "    \n",
    "    # 示例答案\n",
    "    print(\"\\n🎓 参考答案：\")\n",
    "    triples = [\n",
    "        (\"椰子\", \"是\", \"椰汁\", \"的原料\"),\n",
    "        (\"椰汁\", \"作为\", \"奶茶\", \"的原料\"),\n",
    "        (\"红豆\", \"制作\", \"红豆沙\"),\n",
    "        (\"红豆沙\", \"是\", \"糖水\", \"的成分\"),\n",
    "        (\"奶茶\", \"属于\", \"冷饮\"),\n",
    "        (\"糖水\", \"属于\", \"冷饮\")\n",
    "    ]\n",
    "    \n",
    "    for i, (entity1, relation, entity2, desc) in enumerate(triples, 1):\n",
    "        print(f\"   {i}. {entity1} {relation} {entity2} ({desc})\")\n",
    "    \n",
    "    return triples\n",
    "\n",
    "# 执行挑战\n",
    "triples = entity_relation_challenge()\n",
    "\n",
    "print(\"\\n🚀 GraphRAG的核心挑战：\")\n",
    \"print(\"• 实体抽取的准确性\")\n",
    "print(\"• 关系类型的多样性\")\n",
    "print(\"• 知识图谱的维护成本\")\n",
    "print(\"• 查询优化的效率\")"
   ]
