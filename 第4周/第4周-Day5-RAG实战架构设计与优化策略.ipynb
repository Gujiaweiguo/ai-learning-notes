    "# RAG系统性能诊断工具\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def rag_diagnosis_tool():\n",
    "    \"\"\"\n",
    "    RAG系统性能诊断工具\n",
    "    模拟不同配置下的系统性能\n",
    "    \"\"\"\n",
    "    \n",
    "    # 不同的系统配置\n",
    "    configs = [\n",
    "        {'name': '基础RAG', 'chunk_size': 512, 'retrieval_method': 'vector_only', 'rerank': False},\n",
    "        {'name': '优化RAG', 'chunk_size': 512, 'retrieval_method': 'hybrid', 'rerank': True},\n",
    "        {'name': '高级RAG', 'chunk_size': 256, 'retrieval_method': 'multi_modal', 'rerank': True},\n",
    "        {'name': '企业级RAG', 'chunk_size': 1024, 'retrieval_method': 'hybrid', 'rerank': True, 'cache': True}\n",
    "    ]\n",
    "    \n",
    "    # 模拟性能指标\n",
    "    metrics = {\n",
    "        'retrieval_precision': [0.6, 0.8, 0.85, 0.9],\n",
    "        'context_relevance': [0.5, 0.7, 0.75, 0.85],\n",
    "        'answer_accuracy': [0.4, 0.65, 0.7, 0.8],\n",
    "        'response_time': [1.0, 1.5, 2.0, 1.2],  # 包含缓存的优化\n",
    "        'cost': [1.0, 1.8, 2.5, 1.5]  # 相对成本\n",
    "    }\n",
    "    \n",
    "    # 创建雷达图比较\n",
    "    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 6))\n",
    "    \n",
    "    # 雷达图 - 性能指标\n",
    "    categories = ['检索精度', '上下文相关性', '回答准确率', '响应速度', '成本效率']\n",
    "    angles = np.linspace(0, 2 * np.pi, len(categories), endpoint=False).tolist()\n",
    "    angles += angles[:1]  # 闭合图形\n",
    "    \n",
    "    # 标准化指标（0-1范围）\n",
    "    normalized_metrics = {\n",
    "        'retrieval_precision': np.array(metrics['retrieval_precision']),\n",
    "        'context_relevance': np.array(metrics['context_relevance']),\n",
    "        'answer_accuracy': np.array(metrics['answer_accuracy']),\n",
    "        'response_time': 1 - np.array(metrics['response_time']) / max(metrics['response_time']),  # 响应时间越小越好\n",
    "        'cost_efficiency': np.array([m/c for m, c in zip(metrics['answer_accuracy'], metrics['cost'])])\n",
    "    }\n",
    "    \n",
    "    colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4', '#FFEAA7']\n",
    "    \n",
    "    for i, config in enumerate(configs):\n",
    "        values = [\n",
    "            normalized_metrics['retrieval_precision'][i],\n",
    "            normalized_metrics['context_relevance'][i],\n",
    "            normalized_metrics['answer_accuracy'][i],\n",
    "            normalized_metrics['response_time'][i],\n",
    "            normalized_metrics['cost_efficiency'][i]\n",
    "        ]\n",
    "        values += values[:1]  # 闭合图形\n",
    "        \n",
    "        ax1.plot(angles, values, 'o-', linewidth=2, label=config['name'], color=colors[i])\n",
    "        ax1.fill(angles, values, alpha=0.1, color=colors[i])\n",
    "    \n",
    "    ax1.set_xticks(angles[:-1])\n",
    "    ax1.set_xticklabels(categories)\n",
    "    ax1.set_ylim(0, 1)\n",
    "    ax1.set_title('RAG系统性能雷达图', fontsize=14, fontweight='bold')\n",
    "    ax1.legend(loc='upper right', bbox_to_anchor=(1.3, 1))\n",
    "    ax1.grid(True)\n",
    "    \n",
    "    # 性能改进柱状图\n",
    "    improvement = [\",
    "        (metrics['answer_accuracy'][3] - metrics['answer_accuracy'][0]) / metrics['answer_accuracy'][0],\n",
    "        (metrics['response_time'][0] - metrics['response_time'][3]) / metrics['response_time'][0],\n",
    "        (metrics['cost'][0] - metrics['cost'][3]) / metrics['cost'][0]\n",
    "    ]\n",
    "    \n",
    "    bars = ax2.bar(['准确率提升', '响应速度提升', '成本降低'], improvement, color=colors[:3])\n",
    "    ax2.set_title('企业级RAG相比基础RAG的改进', fontsize=14, fontweight='bold')\n",
    "    ax2.set_ylabel('改进比例')\n",
    "    ax2.grid(True, alpha=0.3)\n",
    "    \n",
    "    # 在柱状图上添加数值标签\n",
    "    for bar, value in zip(bars, improvement):\n",
    "        height = bar.get_height()\n",
    "        ax2.text(bar.get_x() + bar.get_width()/2., height,\n",
    "                f'{value:.1%}', ha='center', va='bottom', fontweight='bold')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    # 输出诊断建议\n",
    "    print('🔍 RAG系统诊断建议：\\n')\n",
    "    print('1. 如果检索精度低:')\n",
    "    print('   - 实施混合检索（BM25 + 向量）')\n",
    "    print('   - 优化分块策略和检索参数')\n",
    "    print('   - 添加重排序器提升相关性')\n",
    "    print('\\n2. 如果响应时间长:')\n",
    "    print('   - 实施智能缓存机制')\n",
    "    print('   - 使用异步处理')\n",
    "    print('   - 优化数据库查询')\n",
    "    print('\\n3. 如果成本高:')\n",
    "    print('   - 使用分层存储策略')\n",
    "    print('   - 实施结果缓存')\n",
    "    print('   - 优化模型调用频率')\n",
    "    \n",
    "    return configs, metrics\n",
    "\n",
    "# 运行诊断工具\n",
