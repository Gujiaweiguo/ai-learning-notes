    "colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4', '#FFEAA7']\n",
    "ax1.pie(impact_scores, labels=components, autopct='%1.1f%%', colors=colors, startangle=90)\n",
    "ax1.set_title('RAG系统各组件影响权重')\n",
    "\n",
    "# 性能提升曲线\n",
    "x = np.linspace(0, 100, 100)\n",
    "retrieval_impact = 0.3 * (1 - np.exp(-x/20))\n",
    "context_impact = 0.25 * (1 - np.exp(-x/25))\n",
    "rerank_impact = 0.2 * (1 - np.exp(-x/30))\n",
    "total_impact = retrieval_impact + context_impact + rerank_impact\n",
    "\n",
    "ax2.plot(x, retrieval_impact, label='检索优化', linewidth=2)\n",
    "ax2.plot(x, context_impact, label='上下文优化', linewidth=2)\n",
    "ax2.plot(x, rerank_impact, label='重排序优化', linewidth=2)\n",
    "ax2.plot(x, total_impact, label='总体提升', linewidth=3, linestyle='--')\n",
    "ax2.set_xlabel('优化投入 (%)')\n",
    "ax2.set_ylabel('性能提升 (%)')\n",
    "ax2.set_title('RAG各组件优化效果曲线')\n",
    "ax2.legend()\n",
    "ax2.grid(True, alpha=0.3)\n",
