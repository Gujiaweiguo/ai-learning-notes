    "                            arrowstyle='->', mutation_scale=20,\n",
    "                            color='black', linewidth=2),\n",
    "]\n",
    "\n",
    "for arrow in flow_arrows:\n",
    "    ax.add_patch(arrow)\n",
    "\n",
    "# 添加标题\n",
    "ax.text(8, 9.7, '🧠 RAG完整工作流程', \n",
