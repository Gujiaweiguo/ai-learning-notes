    "# 实际的状态管理代码示例\n",
    "import json\n",
    "from datetime import datetime\n",
    "from typing import Dict, List, Any\n",
    "\n",
    "class AgentStateManager:\n",
    "    \"\"\"\n",
    "    Agent状态管理器\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, storage_type='memory', storage_config=None):\n",
    "        self.storage_type = storage_type\n",
    "        self.storage_config = storage_config or {}\n",
    "        self.state = {}\n",
    "        self.conversation_history = []\n",
    "        self.tool_results = {}\n",
    "        self.session_metadata = {\n",
    "            'created_at': datetime.now().isoformat(),\n",
    "            'last_updated': datetime.now().isoformat(),\n",
    "            'session_id': self._generate_session_id()\n",
    "        }\n",
    "        \n",
    "        # 根据存储类型初始化\n",
    "        if storage_type == 'database':\n",
    "            self._init_database_storage()\n",
    "        elif storage_type == 'file':\n",
    "            self._init_file_storage()\n",
    "    \n",
    "    def _generate_session_id(self):\n",
    "        \"\"\"\n",
    "        生成会话ID\n",
    "        \"\"\"\n",
    "        import uuid\n",
    "        return str(uuid.uuid4())\n",
    "    \n",
    "    def _init_database_storage(self):\n",
    "        \"\"\"\n",
    "        初始化数据库存储（示例）\n",
    "        \"\"\"\n",
    "        db_config = self.storage_config.get('database', {})\n",
    "        self.db_url = db_config.get('url', 'sqlite:///agent_state.db')\n",
    "        print(f\"初始化数据库存储: {self.db_url}\")\n",
    "    \n",
    "    def _init_file_storage(self):\n",
    "        \"\"\"\n",
    "        初始化文件存储\n",
    "        \"\"\"\n",
    "        file_path = self.storage_config.get('file_path', 'agent_state.json')\n",
    "        self.file_path = file_path\n",
    "        print(f\"初始化文件存储: {self.file_path}\")\n",
    "    \n",
    "    def update_state(self, key: str, value: Any, conversation_context: Dict = None):\n",
    "        \"\"\"\n",
    "        更新状态\n",
    "        \n",
    "        Args:\n",
    "            key: 状态键\n",
    "            value: 状态值\n",
    "            conversation_context: 对话上下文\n",
    "        \"\"\"\n",
    "        self.state[key] = {\n",
    "            'value': value,\n",
    "            'timestamp': datetime.now().isoformat(),\n",
    "            'context': conversation_context or {}\n",
    "        }\n",
    "        \n",
    "        # 保存到持久化存储\n",
    "        if self.storage_type != 'memory':\n",
    "            self._save_to_storage()\n",
    "    \n",
    "    def get_state(self, key: str, default=None):\n",
    "        \"\"\"\n",
    "        获取状态\n",
    "        \"\"\"\n",
    "        if key in self.state:\n",
    "            return self.state[key]['value']\n",
    "        return default\n",
    "    \n",
    "    def add_conversation_turn(self, role: str, content: str, metadata: Dict = None):\n",
    "        \"\"\"\n",
    "        添加对话轮次\n",
    "        \"\"\"\n",
    "        turn = {\n",
    "            'role': role,\n",
    "            'content': content,\n",
    "            'timestamp': datetime.now().isoformat(),\n",
    "            'metadata': metadata or {}\n",
    "        }\n",
    "        \n",
    "        self.conversation_history.append(turn)\n",
    "        \n",
    "        # 限制历史长度（避免内存溢出）\n",
    "        max_history = self.storage_config.get('max_history', 50)\n",
    "        if len(self.conversation_history) > max_history:\n",
    "            self.conversation_history = self.conversation_history[-max_history:]\n",
    "        \n",
    "        # 保存到持久化存储\n",
    "        if self.storage_type != 'memory':\n",
    "            self._save_to_storage()\n",
    "    \n",
    "    def get_conversation_context(self, last_n: int = 5):\n",
    "        \"\"\"\n",
    "        获取最近的对话上下文\n",
    "        \"\"\"\n",
    "        recent_turns = self.conversation_history[-last_n:]\n",
    "        context = \"\\n\".join([f\"{turn['role']}: {turn['content']}\" for turn in recent_turns])\n",
    "        return context\n",
    "    \n",
    "    def save_tool_result(self, tool_name: str, result: Any, parameters: Dict = None):\n",
    "        \"\"\"\n",
    "        保存工具调用结果\n",
    "        \"\"\"\n",
    "        self.tool_results[tool_name] = {\n",
    "            'result': result,\n",
    "            'parameters': parameters or {},\n",
    "            'timestamp': datetime.now().isoformat()\n",
    "        }\n",
    "        \n",
    "        # 保存到持久化存储\n",
    "        if self.storage_type != 'memory':\n",
    "            self._save_to_storage()\n",
    "    \n",
    "    def get_tool_result(self, tool_name: str):\n",
    "        \"\"\"\n",
    "        获取工具调用结果\n",
    "        \"\"\"\n",
    "        return self.tool_results.get(tool_name)\n",
    "    \n",
    "    def _save_to_storage(self):\n",
    "        \"\"\"\n",
    "        保存到持久化存储\n",
    "        \"\"\"\n",
    "        if self.storage_type == 'file':\n",
    "            self._save_to_file()\n",
    "        elif self.storage_type == 'database':\n",
    "            self._save_to_database()\n",
    "    \n",
    "    def _save_to_file(self):\n",
    "        \"\"\"\n",
    "        保存到文件\n",
    "        \"\"\"\n",
    "        data = {\n",
    "            'state': self.state,\n",
    "            'conversation_history': self.conversation_history,\n",
    "            'tool_results': self.tool_results,\n",
    "            'session_metadata': self.session_metadata\n",
    "        }\n",
    "        \n",
    "        with open(self.file_path, 'w', encoding='utf-8') as f:\n",
    "            json.dump(data, f, ensure_ascii=False, indent=2)\n",
    "    \n",
    "    def _save_to_database(self):\n",
    "        \"\"\"\n",
    "        保存到数据库（示例）\n",
    "        \"\"\"\n",
    "        print(f\"保存状态到数据库: {self.session_id}\")\n",
    "        # 实际应用中这里会有真实的数据库操作\n",
    "    \n",
    "    def clear_session(self):\n",
    "        \"\"\"\n",
    "        清除当前会话\n",
    "        \"\"\"\n",
    "        self.state = {}\n",
    "        self.conversation_history = []\n",
    "        self.tool_results = {}\n",
    "        self.session_metadata['last_updated'] = datetime.now().isoformat()\n",
    "        \n",
    "        if self.storage_type != 'memory':\n",
    "            self._save_to_storage()\n",
    "\n",
    "# 使用示例\n",
    "print(\"状态管理器示例：\")\n",
    "print(\"=\" * 50)\n",
