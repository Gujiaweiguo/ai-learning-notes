    "# 错误处理与回退策略的代码实现\n",
    "import time\n",
    "import random\n",
    "from typing import Dict, Any, Optional, List\n",
    "\n",
    "class ToolErrorHandler:\n",
    "    \"\"\"\n",
    "    工具错误处理器\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, max_retries=3, retry_delay=1.0):\n",
    "        self.max_retries = max_retries\n",
    "        self.retry_delay = retry_delay\n",
    "        self.error_stats = {}  # 错误统计\n",
    "        self.fallback_strategies = {\n",
    "            'network_error': self._network_fallback,\n",
    "            'parameter_error': self._parameter_fallback,\n",
    "            'timeout_error': self._timeout_fallback,\n",
    "            'permission_error': self._permission_fallback,\n",
    "            'tool_not_found': self._tool_not_found_fallback\n",
    "        }\n",
    "    \n",
    "    def execute_with_retry(self, tool_func, tool_name: str, parameters: Dict, \n",
    "                          context: Dict = None) -> Dict[str, Any]:\n",
    "        \"\"\"\n",
    "        带重试的工具执行\n",
    "        \"\"\"\n",
    "        context = context or {}\n",
    "        \n",
    "        for attempt in range(self.max_retries + 1):\n",
    "            try:\n",
    "                # 执行工具\nn",
    "                result = tool_func(parameters)\n",
    "                \n",
    "                # 记录成功\n",
    "                if tool_name not in self.error_stats:\n",
    "                    self.error_stats[tool_name] = {'success': 0, 'errors': {}}\n",
    "                self.error_stats[tool_name]['success'] += 1\n",
    "                \n",
    "                return {'success': True, 'result': result, 'attempt': attempt + 1}\n",
    "                \n",
    "            except Exception as e:\n",
    "                error_type = self._classify_error(e)\n",
    "                \n",
    "                # 记录错误\n",
    "                if tool_name not in self.error_stats:\n",
    "                    self.error_stats[tool_name] = {'success': 0, 'errors': {}}\n",
    "                if error_type not in self.error_stats[tool_name]['errors']:\n",
    "                    self.error_stats[tool_name]['errors'][error_type] = 0\n",
    "                self.error_stats[tool_name]['errors'][error_type] += 1\n",
    "                \n",
    "                # 判断是否可恢复\n",
    "                if self._is_recoverable(error_type, attempt):\n",
    "                    # 重试逻辑\n",
    "                    if attempt < self.max_retries:\n",
    "                        retry_strategy = self._get_retry_strategy(error_type, attempt)\n",
    "                        context['retry_count'] = attempt + 1\n",
    "                        context['error_type'] = error_type\n",
    "                        \n",
    "                        print(f\"工具 '{tool_name}' 第 {attempt + 1} 次重试... 错误类型: {error_type}\")\n",
    "                        time.sleep(self.retry_delay * (2 ** attempt))  # 指数退避\n",
    "                        \n",
    "                        # 调整参数后重试\n",
    "                        adjusted_params = retry_strategy(parameters, context)\n",
    "                        if adjusted_params:\n",
    "                            parameters = adjusted_params\n",
    "                        continue\n",
    "                \n",
    "                # 不可恢复错误，使用回退策略\n",
    "                fallback_result = self._apply_fallback(error_type, tool_name, parameters, context)\n",
    "                return {\n",
    "                    'success': False, \n",
    "                    'error': str(e),\n",
    "                    'error_type': error_type,\n",
    "                    'fallback_result': fallback_result,\n",
    "                    'attempt': attempt + 1\n",
    "                }\n",
    "    \n",
    "    def _classify_error(self, error: Exception) -> str:\n",
    "        \"\"\"\n",
    "        错误类型分类\n",
    "        \"\"\"\n",
    "        error_str = str(error).lower()\n",
    "        \n",
    "        if any(keyword in error_str for keyword in ['network', 'connection', 'timeout']):\n",
    "            return 'network_error'\n",
    "        elif any(keyword in error_str for keyword in ['parameter', 'argument', 'invalid']):\n",
    "            return 'parameter_error'\n",
    "        elif any(keyword in error_str for keyword in ['timeout', 'time limit']):\n",
    "            return 'timeout_error'\n",
    "        elif any(keyword in error_str for keyword in ['permission', 'access', 'forbidden']):\n",
    "            return 'permission_error'\n",
    "        else:\n",
    "            return 'tool_not_found'\n",
    "    \n",
    "    def _is_recoverable(self, error_type: str, attempt: int) -> bool:\n",
    "        \"\"\"\n",
    "        判断错误是否可恢复\n",
    "        \"\"\"\n",
    "        recoverable_errors = ['network_error', 'timeout_error']\n",
    "        return error_type in recoverable_errors and attempt < self.max_retries\n",
    "    \n",
    "    def _get_retry_strategy(self, error_type: str, attempt: int) -> callable:\n",
    "        \"\"\"\n",
    "        获取重试策略\n",
    "        \"\"\"\n",
    "        strategies = {\n",
    "            'network_error': self._network_retry_strategy,\n",
    "            'timeout_error': self._timeout_retry_strategy\n",
    "        }\n",
    "        return strategies.get(error_type, lambda params, ctx: params)\n",
    "    \n",
    "    def _network_retry_strategy(self, parameters: Dict, context: Dict) -> Dict:\n",
    "        \"\"\"\n",
    "        网络错误重试策略\n",
    "        \"\"\"\n",
    "        # 添加网络重试特定的参数\n",
    "        retry_params = parameters.copy()\n",
    "        retry_params['timeout'] = parameters.get('timeout', 30) * 1.5  # 增加超时时间\n",
    "        retry_params['retry_attempts'] = context.get('retry_count', 1)\n",
    "        return retry_params\n",
    "    \n",
    "    def _timeout_retry_strategy(self, parameters: Dict, context: Dict) -> Dict:\n",
    "        \"\"\"\n",
    "        超时错误重试策略\n",
    "        \"\"\"\n",
    "        retry_params = parameters.copy()\n",
    "        retry_params['timeout'] = parameters.get('timeout', 30) * 2  # 加倍超时\n",
    "        retry_params['use_cache'] = True  # 启用缓存\n",
    "        return retry_params\n",
    "    \n",
    "    def _apply_fallback(self, error_type: str, tool_name: str, \n",
    "                        parameters: Dict, context: Dict) -> Any:\n",
    "        \"\"\"\n",
    "        应用回退策略\n",
    "        \"\"\"\n",
    "        fallback_func = self.fallback_strategies.get(error_type)\n",
    "        if fallback_func:\n",
    "            return fallback_func(tool_name, parameters, context)\n",
    "        else:\n",
    "            return f\"工具 '{tool_name}' 执行失败，请稍后重试\"\n",
    "    \n",
    "    def _network_fallback(self, tool_name: str, parameters: Dict, context: Dict) -> Any:\n",
    "        \"\"\"\n",
    "        网络错误回退策略\n",
    "        \"\"\"\n",
    "        print(f\"网络错误回退策略应用于 {tool_name}\")\n",
    "        # 返回缓存结果或默认数据\n",
    "        return {\n",
    "            'status': 'offline',\n",
    "            'message': '网络连接失败，使用本地缓存数据',\n",
    "            'cached_data': '上次成功查询的结果'\n",
    "        }\n",
    "    \n",
    "    def _parameter_fallback(self, tool_name: str, parameters: Dict, context: Dict) -> Any:\n",
    "        \"\"\"\n",
    "        参数错误回退策略\n",
    "        \"\"\"\n",
    "        print(f\"参数错误回退策略应用于 {tool_name}\")\n",
    "        # 使用默认参数\n",
    "        default_params = {\n",
    "            'search': {'query': '', 'limit': 10},\n",
    "            'calculate': {'expression': '0'},\n",
    "            'weather': {'location': '默认位置'}\n",
    "        }\n",
    "        \n",
    "        tool_defaults = default_params.get(tool_name, {})\n",
    "        return {\n",
    "            'status': 'parameter_error',\n",
    "            'message': '参数格式错误，使用默认值',\n",
    "            'default_result': tool_defaults\n",
    "        }\n",
    "    \n",
    "    def _timeout_fallback(self, tool_name: str, parameters: Dict, context: Dict) -> Any:\n",
    "        \"\"\"\n",
    "        超时错误回退策略\n",
    "        \"\"\"\n",
    "        print(f\"超时错误回退策略应用于 {tool_name}\")\n",
    "        return {\n",
    "            'status': 'timeout',\n",
    "            'message': '请求超时，返回部分结果',\n",
    "            'partial_result': '已获取的部分数据'\n",
    "        }\n",
    "    \n",
    "    def _permission_fallback(self, tool_name: str, parameters: Dict, context: Dict) -> Any:\n",
    "        \"\"\"\n",
    "        权限错误回退策略\n",
    "        \"\"\"\n",
    "        print(f\"权限错误回退策略应用于 {tool_name}\")\n",
    "        return {\n",
    "            'status': 'permission_denied',\n",
    "            'message': '权限不足，无法执行该操作',\n",
    "            'suggestion': '请检查您的权限设置或联系管理员'\n",
    "        }\n",
    "    \n",
    "    def _tool_not_found_fallback(self, tool_name: str, parameters: Dict, context: Dict) -> Any:\n",
    "        \"\"\"\n",
    "        工具不存在回退策略\n",
    "        \"\"\"\n",
    "        print(f\"工具不存在回退策略应用于 {tool_name}\")\n",
    "        return {\n",
    "            'status': 'tool_not_found',\n",
    "            'message': f'工具 {tool_name} 不存在',\n",
    "            'available_tools': ['search', 'calculate', 'weather']\n",
    "        }\n",
    "    \n",
    "    def get_error_stats(self) -> Dict[str, Any]:\n",
    "        \"\"\"\n",
    "        获取错误统计信息\n",
    "        \"\"\"\n",
    "        return self.error_stats\n",
n",
    "    \n",
    "    def get_success_rate(self, tool_name: str) -> float:\n",
    "        \"\"\"\n",
    "        计算工具成功率\n",
    "        \"\"\"\n",
    "        if tool_name not in self.error_stats:\n",
    "            return 0.0\n",
    "        \n",
    "        stats = self.error_stats[tool_name]\n",
    "        total_attempts = stats['success'] + sum(stats['errors'].values())\n",
    "        if total_attempts == 0:\n",
    "            return 0.0\n",
    "        \n",
    "        return stats['success'] / total_attempts\n",
    "\n",
    "# 使用示例\n",
    "print(\"错误处理与回退策略示例：\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# 创建错误处理器\n",
    "error_handler = ToolErrorHandler(max_retries=3)\n",
    "\n",
    "# 模拟工具函数\n",
    "def unreliable_search_tool(parameters):\n",
    "    \"\"\"模拟不可靠的搜索工具\"\"\"\n",
    "    if random.random() < 0.3:  # 30%概率失败\n",
    "        raise Exception(\"Network connection timeout\")\n",
    "    if random.random() < 0.2:  # 20%概率参数错误\n",
    "        raise Exception(\"Invalid parameter format\")\n",
    "    \n",
    "    query = parameters.get('query', 'default')\n",
    "    return {\n",
    "        'result': f'搜索结果关于 {query}',\n",
    "        'count': random.randint(5, 50),\n",
    "        'success': True\n",
    "    }\n",
    "\n",
    "def unreliable_calculator_tool(parameters):\n",
    "    \"\"\"模拟不可靠的计算工具\"\"\"\n",
    "    expression = parameters.get('expression', '')\n",
    "    if random.random() < 0.25:  # 25%概率失败\n",
    "        raise Exception(\"Calculation timeout\")\n",
    "    \n",
    "    try:\n",
    "        result = eval(expression)  # 注意：实际应用中应使用更安全的方式\n",
    "        return {\n",
    "            'result': f'{expression} = {result}',\n",
    "            'success': True\n",
    "        }\n",
    "    except:\n",
    "        raise Exception(\"Invalid expression\")\n",
    "\n",
    "# 测试工具执行\n",
    "print(\"测试搜索工具（可能失败）：\")\n",
    "for i in range(5):\n",
    "    result = error_handler.execute_with_retry(\n",
