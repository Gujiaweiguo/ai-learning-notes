    "### 代码示例：简单的Agent框架架构"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class SimpleAgent:\n",
    "    def __init__(self, llm_model, tools):\n",
    "        \"\"\"\n",
    "        初始化Agent框架\n",
    "        \n",
    "        Args:\n",
    "            llm_model: LLM模型实例\n",
    "            tools: 工具列表 [tool1, tool2, ...]\n",
    "        \"\"\"\n",
    "        self.llm = llm_model\n",
    "        self.tools = {tool.name: tool for tool in tools}\n",
    "        self.state = {}  # 状态管理\n",
    "        self.conversation_history = []  # 对话历史\n",
    "    \n",
    "    def process_user_input(self, user_input):\n",
    "        \"\"\"\n",
    "        处理用户输入\n",
    "        \"\"\"\n",
    "        # 1. 将用户输入加入对话历史\n",
    "        self.conversation_history.append({\"role\": \"user\", \"content\": user_input})\n",
    "        \n",
    "        # 2. LLM分析并决定工具调用\n",
    "        reasoning = self.llm.reason(user_input, self.state)\n",
    "        \n",
    "        # 3. 执行工具调用\n",
    "        tool_calls = self._execute_tools(reasoning)\n",
    "        \n",
    "        # 4. 整合结果并生成回复\n",
    "        response = self.llm.generate_response(tool_calls, self.state)\n",
    "        \n",
    "        # 5. 更新状态和对话历史\n",
    "        self.state.update(tool_results)\n",
    "        self.conversation_history.append({\"role\": \"assistant\", \"content\": response})\n",
    "        \n",
    "        return response\n",
    "    \n",
    "    def _execute_tools(self, reasoning):\n",
    "        \"\"\"\n",
    "        执行工具调用的核心逻辑\n",
    "        \"\"\"\n",
    "        tool_results = {}\n",
    "        \n",
    "        for step in reasoning.steps:\n",
    "            if step.get('tool_needed'):\n",
    "                tool_name = step['tool_name']\n",
    "                tool_params = step['parameters']\n",
    "                \n",
    "                if tool_name in self.tools:\n",
    "                    try:\n",
    "                        # 调用工具并捕获结果\n",
    "                        result = self.tools[tool_name].execute(tool_params)\n",
    "                        tool_results[tool_name] = result\n",
    "                    except Exception as e:\n",
    "                        # 错误处理\n",
    "                        tool_results[tool_name] = f\"工具调用失败: {str(e)}\"\n",
    "                        # 回退策略：使用默认值或跳过\n",
    "                        if self._should_fallback(tool_name):\n",
    "                            result = self._get_fallback_result(tool_name)\n",
    "                            tool_results[tool_name] = result\n",
    "                else:\n",
    "                    tool_results[tool_name] = \"工具不存在\"\n",
    "        \n",
    "        return tool_results\n",
    "    \n",
    "    def _should_fallback(self, tool_name):\n",
    "        \"\"\"\n",
    "        判断是否需要回退策略\n",
    "        \"\"\"\n",
    "        # 可以根据工具重要性决定是否回退\n",
    "        return True  # 简化示例：总是尝试回退\n",
    "    \n",
    "    def _get_fallback_result(self, tool_name):\n",
    "        \"\"\"\n",
    "        获取回退结果\n",
    "        \"\"\"\n",
    "        fallbacks = {\n",
    "            'search': \"无法搜索，请稍后重试\",\n",
    "            'calculate': \"计算失败，请检查输入参数\",\n",
    "            'file_read': \"文件读取失败\"\n",
    "        }\n",
    "        return fallbacks.get(tool_name, \"未知错误\")\n",
    "\n",
    "# 工具基类\n",
    "class BaseTool:\n",
    "    def __init__(self, name, description):\n",
    "        self.name = name\n",
    "        self.description = description\n",
    "    \n",
    "    def execute(self, parameters):\n",
    "        raise NotImplementedError\n",
    "\n",
    "# 具体工具示例\n",
    "class SearchTool(BaseTool):\n",
    "    def __init__(self):\n",
    "        super().__init__(\"search\", \"网络搜索工具\")\n",
    "    \n",
    "    def execute(self, parameters):\n",
    "        query = parameters.get('query', '')\n",
    "        # 这里应该是真实的搜索逻辑\n",
    "        return f\"搜索结果：关于'{query}'的信息...\"\n",
    "\n",
    "class CalculatorTool(BaseTool):\n",
    "    def __init__(self):\n",
    "        super().__init__(\"calculate\", \"数学计算工具\")\n",
    "    \n",
    "    def execute(self, parameters):\n",
    "        expression = parameters.get('expression', '')\n",
    "        try:\n",
    "            result = eval(expression)  # 注意：实际应用中应使用更安全的计算方式\n",
    "            return f\"计算结果：{expression} = {result}\"\n",
    "        except:\n",
    "            return \"计算表达式无效\"\n",
    "\n",
    "# 创建Agent实例\n",
    "llm_model = \"模拟LLM模型\"  # 实际应该是LLM实例\n",
    "tools = [SearchTool(), CalculatorTool()]\n",
    "agent = SimpleAgent(llm_model, tools)\n",
    "\n",
    "# 示例使用\n",
    "user_input = \"帮我计算 2+2*3 的结果\"\n",
    "print(f\"用户输入: {user_input}\")\n",
    "print(f\"Agent回复: {agent.process_user_input(user_input)}\")\n",
    "\n",
    "print(\"\\n\" + \"=\"*50 + \"\\n\")\n",
    "print(\"Agent框架核心特点：\")\n",
    "print(\"1. 模块化设计：LLM、工具、执行引擎相互独立\")\n",
    "print(\"2. 状态管理：保持对话连续性和上下文\")\n",
    "print(\"3. 错误处理：优雅的降级机制\")\n",
    "print(\"4. 工具编排：智能选择和组合工具\")"
   ]
