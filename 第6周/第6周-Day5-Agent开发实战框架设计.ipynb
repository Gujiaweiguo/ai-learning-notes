    "        print(f\"  回退结果: {result['fallback_result']}\")\n",
    "    print()\n",
    "\n",
    "print(\"测试计算工具：\")\n",
    "for i in range(3):\n",
    "    result = error_handler.execute_with_retry(\n",
    "        unreliable_calculator_tool,\n",
    "        'calculate',\n",
    "        {'expression': '2 + 2 * 3'}\n",
    "    )\n",
    "    print(f\"尝试 {i+1}: {'成功' if result['success'] else '失败'}\")\n",
    "    print()\n",
    "\n",
    "# 显示错误统计\n",
    "print(\"错误统计信息：\")\n",
    "print(json.dumps(error_handler.get_error_stats(), indent=2, ensure_ascii=False))\n",
    "\n",
    "print(\"\\n错误处理优势：\")\n",
    "print(\"1. 自动重试机制 - 对临时网络问题自动恢复\")\n",
    "print(\"2. 智能错误分类 - 针对不同错误类型采用不同策略\")\n",
