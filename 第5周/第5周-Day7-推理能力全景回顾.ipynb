   "source": [
    "# 可视化不同推理方法的效果对比\n",
    "def plot_reasoning_comparison():\n",
    "    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 6))\n",
    "    \n",
    "    # 左图：推理方法准确率对比\n",
    "    methods = ['零样本', '思维链', '树状推理', 'DeepSeek R1', 'ReAct']\n",
    "    accuracy = [65, 85, 88, 92, 90]\n",
    "    time_cost = [1, 3, 5, 8, 6]  # 相对时间成本\n",
    "    \n",
    "    x = np.arange(len(methods))\n",
    "    width = 0.35\n",
    "    \n",
    "    bars1 = ax1.bar(x - width/2, accuracy, width, label='准确率(%)', color=colors[0:2] + colors[3:])\n",
    "    bars2 = ax1.bar(x + width/2, time_cost, width, label='时间成本(相对)', color=colors[2])\n",
    "    \n",
    "    ax1.set_xlabel('推理方法')\n",
    "    ax1.set_ylabel('数值')\n",
    "    ax1.set_title('推理方法性能对比', fontsize=14, fontweight='bold')\n",
    "    ax1.set_xticks(x)\n",
    "    ax1.set_xticklabels(methods)\n",
    "    ax1.legend()\n",
    "    ax1.grid(True, alpha=0.3)\n",
    "    \n",
    "    # 在柱状图上添加数值标签\n",
    "    for i, (bar1, bar2) in enumerate(zip(bars1, bars2)):\n",
    "        height1 = bar1.get_height()\n",
    "        height2 = bar2.get_height()\n",
    "        ax1.text(bar1.get_x() + bar1.get_width()/2., height1 + 1,\n",
    "                f'{accuracy[i]}%', ha='center', va='bottom', fontsize=9)\n",
    "        ax1.text(bar2.get_x() + bar2.get_width()/2., height2 + 0.2,\n",
    "                f'{time_cost[i]}', ha='center', va='bottom', fontsize=9)\n",
    "    \n",
    "    # 右图：推理复杂度分析\n",
    "    complexity_data = [\n",
    "        {'method': '零样本', 'complexity': 1, 'accuracy': 65},\n",
    "        {'method': '思维链', 'complexity': 2, 'accuracy': 85},\n",
    "        {'method': '树状推理', 'complexity': 4, 'accuracy': 88},\n",
    "        {'method': 'DeepSeek R1', 'complexity': 5, 'accuracy': 92},\n",
    "        {'method': 'ReAct', 'complexity': 3, 'accuracy': 90}\n",
    "    ]\n",
    "    \n",
    "    for data in complexity_data:\n",
    "        ax2.scatter(data['complexity'], data['accuracy'], s=100, \n",
    "                   label=data['method'], alpha=0.7)\n",
    "    \n",
    "    # 添加趋势线\n",
    "    complexities = [d['complexity'] for d in complexity_data]\n",
    "    accuracies = [d['accuracy'] for d in complexity_data]\n",
    "    z = np.polyfit(complexities, accuracies, 2)\n",
    "    p = np.poly1d(z)\n",
    "    x_trend = np.linspace(min(complexities), max(complexities), 100)\n",
    "    ax2.plot(x_trend, p(x_trend), 'r--', alpha=0.8, label='准确率趋势')\n",
    "    \n",
    "    ax2.set_xlabel('实现复杂度')\n",
    "    ax2.set_ylabel('准确率(%)')\n",
    "    ax2.set_title('推理方法投入产出分析', fontsize=14, fontweight='bold')\n",
    "    ax2.legend()\n",
    "    ax2.grid(True, alpha=0.3)\n",
    "    ax2.set_ylim(50, 100)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# 执行可视化\n",
    "plot_reasoning_comparison()"
   ]
  },
