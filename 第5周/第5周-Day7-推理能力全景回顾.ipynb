    "## 💡 推理能力的实际业务应用\n",
    "\n",
    "让我们思考如何将这些推理技术应用到糖水店的日常运营中："
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
    "metadata": {},
    "outputs": [],
    "source": [
    "# 创建糖水店推理应用场景\n",
    "class BusinessReasoningDemo:\n",
    "    def __init__(self):\n",
    "        self.customer_data = [\n",
    "            \"顾客说要一杯冰的绿豆沙，不要太甜\",\n",
    "            \"小朋友想要草莓味的，但要少糖\",\n",
    "            \"老人要热的红豆沙，要煮得软烂一些\",\n",
    "            \"顾客说想试试新推出的芒果口味\",\n",
    "            \"外国游客想要一杯中国传统的糖水\"\n",
    "        ]\n",
    "        \n",
    "    def apply_reasoning(self, customer_request, method='chain_of_thought'):\n",
    "        \"\"\"应用推理技术处理顾客请求\"\"\"\n",
    "        if method == 'chain_of_thought':\n",
    "            return self.chain_of_thought_reasoning(customer_request)\n",
    "        elif method == 'tree_of_thought':\n",
    "            return self.tree_of_thought_reasoning(customer_request)\n",
    "        else:\n",
    "            return self.simple_reasoning(customer_request)\n",
    "    \n",
    "    def chain_of_thought_reasoning(self, request):\n",
    "        \"\"\"思维链处理顾客请求\"\"\"\n",
    "        steps = [\n",
    "            f\"步骤1: 分析顾客请求 - '{request}'\",\n",
    "            \"步骤2: 识别关键要素 - 口味、温度、甜度、特殊要求\",\n",
    "            \"步骤3: 匹配糖水类型 - 根据口味选择基础糖水\",\n",
    "            \"步骤4: 调整制作参数 - 温度、甜度、配料\",\n",
    "            \"步骤5: 预估制作时间 - 根据复杂度计算等待时间\",\n",
    "            \"步骤6: 确认价格 - 根据配料成本计算售价\"\n",
    "        ]\n",
    "        return {\n",
    "            'method': '思维链',\n",
    "            'reasoning': \"\\n\".join(steps),\n",
