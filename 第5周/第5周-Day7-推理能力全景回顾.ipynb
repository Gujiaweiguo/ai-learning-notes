    "    ax.set_xlabel('完成度 (%)')\n",
    "    ax.set_yticks([])\n",
    "    ax.legend()\n",
    "    ax.grid(True, alpha=0.3)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
