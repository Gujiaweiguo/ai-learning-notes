    "## 🔧 推理技术实现示例\n",
    "\n",
    "让我们通过代码实现来理解不同推理技术的差异："
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 实现不同的推理策略\n",
    "class ReasoningDemo:\n",
    "    def __init__(self):\n",
    "        self.questions = [\n",
    "            \"一个糖水店一天做了100碗糖水，每碗成本5元，售价15元。如果其中20%的糖水因为温度不合适需要重新制作，请问当天的净利润是多少？\",\n",
    "            \"有5个人排队买糖水，第一个人买1碗，第二个人买2碗，第三个人买3碗，依此类推。如果每碗糖水需要3分钟制作，且同时可以制作2碗，请问所有人买完需要多长时间？\"\n",
    "        ]\n",
    "        \n",
    "    def zero_shot_reasoning(self, question):\n",
    "        \"\"\"零样本直接回答\"\"\"\n",
    "        return f\"零样本推理对问题 '{question[:30]}...' 的直接回答\"\n",
    "    \n",
    "    def chain_of_thought_reasoning(self, question):\n",
    "        \"\"\"思维链推理\"\"\"\n",
    "        reasoning_steps = [\n",
    "            f\"步骤1: 理解问题 - {question[:30]}...\",\n",
    "            \"步骤2: 识别关键信息 - 总数量、成本、售价、损耗率\",\n",
    "            \"步骤3: 计算总收入 = 100碗 × 15元/碗 = 1500元\",\n",
    "            \"步骤4: 计算总成本 = 100碗 × 5元/碗 = 500元\",\n",
    "            \"步骤5: 计算重新制作成本 = 20碗 × 5元/碗 = 100元\",\n",
    "            \"步骤6: 计算净利润 = 1500元 - 500元 - 100元 = 900元\"\n",
    "        ]\n",
    "        return \"\\n\".join(reasoning_steps)\n",
    "    \n",
    "    def tree_of_thought_reasoning(self, question):\n",
    "        \"\"\"树状推理\"\"\"\n",
    "        branches = [\n",
    "            {\n",
    "                \"branch\": \"基础计算\",\n",
    "                \"steps\": [\n",
    "                    \"净利润 = 收入 - 成本\",\n",
    "                    \"收入 = 售价 × 数量 = 15元 × 100 = 1500元\",\n",
    "                    \"成本 = 原材料成本 + 重新制作成本\",\n",
    "                    \"重新制作成本 = 5元 × (100 × 20%) = 100元\",\n",
    "                    \"总成本 = 5元 × 100 + 100元 = 600元\",\n",
    "                    \"净利润 = 1500元 - 600元 = 900元\"\n",
    "                ]\n",
    "            },\n",
    "            {\n",
    "                \"branch\": \"损耗分析\",\n",
    "                \"steps\": [\n",
    "                    \"损耗率 = 20%\",\n",
    "                    \"有效销售数量 = 100 × (1 - 20%) = 80碗\",\n",
    "                    \"有效收入 = 15元 × 80 = 1200元\",\n",
    "                    \"总成本 = 100 × 5 = 500元\",\n",
    "                    \"净利润 = 1200元 - 500元 = 700元\"\n",
    "                ]\n",
    "            }\n",
    "        ]\n",
    "        return branches\n",
    "    \n",
    "    def demonstrate_reasoning(self):\n",
    "        \"\"\"演示不同的推理方法\"\"\"\n",
    "        print(\"🔍 推理方法对比演示\")\n",
    "        print(\"=\" * 50)\n",
    "        \n",
    "        question = self.questions[0]\n",
    "        print(f\"\\n📝 问题: {question}\")\n",
    "        print(\"\\n\" + \"=\" * 50)\n",
    "        \n",
    "        # 零样本推理\n",
    "        print(\"\\n🟡 零样本推理:\")\n",
    "        result_zero = self.zero_shot_reasoning(question)\n",
    "        print(result_zero)\n",
    "        \n",
    "        # 思维链推理\n",
    "        print(\"\\n🔵 思维链推理:\")\n",
    "        result_cot = self.chain_of_thought_reasoning(question)\n",
    "        print(result_cot)\n",
    "        \n",
    "        # 树状推理\n",
    "        print(\"\\n🟢 树状推理:\")\n",
    "        result_tot = self.tree_of_thought_reasoning(question)\n",
    "        for i, branch in enumerate(result_tot, 1):\n",
    "            print(f\"\\n分支{i}: {branch['branch']}\")\n",
    "            for step in branch['steps']:\n",
    "                print(f\"  • {step}\")\n",
    "\n",
    "# 创建推理演示实例\n",
    "demo = ReasoningDemo()\n",
    "demo.demonstrate_reasoning()"
   ]
  },
