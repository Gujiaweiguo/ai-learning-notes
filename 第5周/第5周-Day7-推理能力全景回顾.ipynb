    "        ax.barh(i, 10, left=0, height=0.8, color='lightgray', alpha=0.3)\n",
    "        # 进度条\n",
    "        color = colors[i] if prog > 0 else 'gray'\n",
    "        ax.barh(i, prog, left=0, height=0.8, color=color, alpha=0.8)\n",
