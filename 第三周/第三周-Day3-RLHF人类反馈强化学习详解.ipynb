   "source": [
    "# 🧠🤖 每日学习笔记 | 第三周-Day3\n",
    "\n",
    "## RLHF：人类反馈强化学习详解\n",
    "\n",
    "今天是第三周的第三天，我们要深入理解RLHF这个让ChatGPT变得"善解人意"的核心技术！🎯"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 📝 RLHF核心概念\n",
    "\n",
    "RLHF（Reinforcement Learning from Human Feedback）就是**人类反馈强化学习**，简单说就是：\n",
    "\n",
    "🔹 **传统AI训练**：看大量数据，模仿学习\n",
    "🔹 **RLHF训练**：让AI先看，然后人类告诉它哪个回答更好，AI根据人类的"打分"来优化自己\n",
    "\n",
    "就像老师批改作业 - AI写答案，人类给评价，AI根据评价改进答案！"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# 设置中文显示\n",
    "plt.rcParams['font.sans-serif'] = ['SimHei']\n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "\n",
    "# 可视化RLHF的基本流程\n",
    "def visualize_rlhf_flow():\n",
    "    fig, ax = plt.subplots(1, 1, figsize=(12, 6))\n",
    "    \n",
    "    # 流程步骤\n",
    "    steps = ['模型生成回答', '人类偏好比较', '奖励模型训练', 'PPO优化', '改进模型']\n",
    "    positions = [0, 2, 4, 6, 8]\n",
    "    \n",
    "    for i, (step, pos) in enumerate(zip(steps, positions)):\n",
    "        circle = plt.Circle((pos, 0), 0.3, color=plt.cm.viridis(i/4), alpha=0.7)\n",
    "        ax.add_patch(circle)\n",
    "        ax.text(pos, 0, step, ha='center', va='center', fontsize=9, weight='bold')\n",
    "    \n",
    "    # 箭头\n",
    "    for i in range(len(positions)-1):\n",
    "        ax.annotate('', xy=(positions[i+1]-0.3, 0), xytext=(positions[i]+0.3, 0),\n",
    "                   arrowprops=dict(arrowstyle='->', lw=2, color='blue'))\n",
    "    \n",
    "    ax.set_xlim(-1, 9)\n",
    "    ax.set_ylim(-1, 1)\n",
    "    ax.set_title('RLHF训练流程', fontsize=14, weight='bold')\n",
    "    ax.axis('off')\n",
    "    \n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "visualize_rlhf_flow()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 🔑 RLHF的三个核心阶段\n",
    "\n",
    "#### 阶段1：监督微调（SFT）\n",
    "给高质量的人类问答数据，让模型"学会"如何回答问题\n",
    "\n",
    "#### 阶段2：奖励模型训练（RM）\n",
    "人类对AI的回答进行排序训练，教会AI"什么回答更好"\n",
    "\n",
    "#### 阶段3：强化学习优化（PPO）\n",
    "AI根据奖励模型的指导，不断优化自己的回答策略"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 模拟奖励模型训练过程\n",
    "def simulate_reward_model():\n",
    "    # 模拟人类偏好数据\n",
    "    np.random.seed(42)\n",
    "    \n",
    "    # 生成多个AI回答\n",
    "    responses = [\n",
    "        \"这是一个很复杂的问题，需要详细分析...\",\n",
    "        \"根据我的理解，这个问题的答案是...\",\n",
    "        \"抱歉，我不太理解你的问题。\",\n",
    "        \"简单来说，核心要点是...\"\n",
    "    ]\n",
    "    \n",
    "    # 模拟人类对这些回答的偏好\n",
    "    preference_scores = np.random.normal(loc=[80, 85, 40, 90], scale=[10, 8, 5, 7])\n",
    "    \n",
    "    # 创建图表\n",
    "    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))\n",
    "    \n",
    "    # 左侧：原始回答质量\n",
    "    colors = ['lightblue', 'lightgreen', 'lightcoral', 'lightyellow']\n",
    "    bars1 = ax1.bar(range(len(responses)), preference_scores, color=colors, alpha=0.7)\n",
    "    ax1.set_ylabel('人类评分 (0-100)')\n",
    "    ax1.set_title('AI回答质量评估')\n",
    "    ax1.set_xticks(range(len(responses)))\n",
    "    ax1.set_xticklabels([f'回答{i+1}' for i in range(len(responses))])\n",
    "    ax1.set_ylim(0, 100)\n",
    "    \n",
    "    # 在柱子上添加分数\n",
    "    for bar, score in zip(bars1, preference_scores):\n",
    "        height = bar.get_height()\n",
    "        ax1.text(bar.get_x() + bar.get_width()/2., height + 2,\n",
    "                f'{int(score)}', ha='center', va='bottom')\n",
    "    \n",
    "    # 右侧：奖励模型学习过程\n",
    "    epochs = np.arange(1, 21)\n",
    "    reward_scores = []\n",
    "    for epoch in epochs:\n",
    "        # 模拟学习过程：分数逐渐接近真实偏好\n",
    "        learned_score = 50 + (preference_scores.mean() - 50) * (1 - np.exp(-epoch/10)) + np.random.normal(0, 5)\n",
    "        reward_scores.append(learned_score)\n",
    "    \n",
    "    ax2.plot(epochs, reward_scores, 'b-', linewidth=2, label='奖励模型预测分数')\n",
    "    ax2.axhline(y=preference_scores.mean(), color='r', linestyle='--', label='真实平均偏好')\n",
    "    ax2.set_xlabel('训练轮次')\n",
    "    ax2.set_ylabel('预测分数')\n",
    "    ax2.set_title('奖励模型学习过程')\n",
    "    ax2.legend()\n",
    "    ax2.grid(True, alpha=0.3)\n",
    "    \n",
    "    plt.suptitle('RLHF奖励模型训练模拟', fontsize=16, weight='bold')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    return responses, preference_scores\n",
    "\n",
    "responses, scores = simulate_reward_model()"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# PPO算法简化实现\n",
    "def simple_ppo_demo():\n",
    "    \"\"\"简化版的PPO算法演示\"\"\"\n",
    "    \n",
    "    # 模拟策略网络（简化）\n",
    "    class SimplePolicy:\n",
    "        def __init__(self):\n",
    "            self.params = np.random.randn(2)  # 简化为2个参数\n",
    "        \n",
    "        def forward(self, x):\n",
        "            return np.dot(x, self.params)\n",
    "        \n",
    "        def update(self, gradient, lr=0.01):\n",
    "            self.params += lr * gradient\n",
    "    \n",
    "    # 创建策略\n",
    "    policy = SimplePolicy()\n",
    "    \n",
    "    # 模拟训练过程\n",
    "    episodes = 50\n",
    "    lr = 0.02\n",
    "    kl_penalty = 0.1  # KL散度惩罚\n",
    "    \n",
    "    policy_params = [policy.params.copy()]\n",
    "    rewards = []\n",
    "    \n",
    "    for episode in range(episodes):\n",
    "        # 生成随机输入\n",
    "        x = np.random.randn(2)\n",
        "        \n",
    "        # 当前策略输出\n",
    "        current_output = policy.forward(x)\n",
    "        \n",
    "        # 模拟奖励（基于输出质量）\n",
    "        reward = np.tanh(current_output) * 10  # 简化的奖励函数\n",
    "        rewards.append(reward)\n",
    "        \n",
    "        # 计算梯度\n",
    "        gradient = x * reward  # 简化的梯度计算\n",
    "        \n",
    "        # KL散度约束（简化）\n",
    "        kl_divergence = np.sum((policy.params - policy_params[-1])**2) * kl_penalty\n",
    "        \n",
    "        # 更新策略\n",
    "        policy.update(gradient - policy.params * kl_penalty, lr)\n",
    "        policy_params.append(policy.params.copy())\n",
    "    \n",
    "    # 可视化\n",
    "    fig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2, figsize=(15, 10))\n",
    "    \n",
    "    # 1. 策略参数变化\n",
    "    params_array = np.array(policy_params)\n",
    "    ax1.plot(params_array[:, 0], label='参数1', linewidth=2)\n",
    "    ax1.plot(params_array[:, 1], label='参数2', linewidth=2)\n",
    "    ax1.set_xlabel('训练轮次')\n",
    "    ax1.set_ylabel('参数值')\n",
    "    ax1.set_title('PPO策略参数变化')\n",
    "    ax1.legend()\n",
    "    ax1.grid(True, alpha=0.3)\n",
    "    \n",
    "    # 2. 奖励变化\n",
    "    ax2.plot(rewards, color='green', linewidth=2)\n",
    "    ax2.set_xlabel('训练轮次')\n",
    "    ax2.set_ylabel('奖励值')\n",
    "    ax2.set_title('PPO训练奖励变化')\n",
    "    ax2.grid(True, alpha=0.3)\n",
    "    \n",
    "    # 3. 策略输出分布\n",
    "    test_inputs = np.random.randn(100, 2)\n",
    "    outputs = [policy.forward(x) for x in test_inputs]\n",
    "    ax3.hist(outputs, bins=30, alpha=0.7, color='skyblue', edgecolor='black')\n",
    "    ax3.set_xlabel('策略输出')\n",
    "    ax3.set_ylabel('频次')\n",
    "    ax3.set_title('最终策略输出分布')\n",
    "    ax3.grid(True, alpha=0.3)\n",
    "    \n",
    "    # 4. 学习曲线\n",
    "    moving_avg = np.convolve(rewards, np.ones(5)/5, mode='valid')\n",
    "    ax4.plot(rewards, alpha=0.3, color='gray', label='原始奖励')\n",
    "    ax4.plot(moving_avg, color='red', linewidth=3, label='5轮移动平均')\n",
    "    ax4.set_xlabel('训练轮次')\n",
    "    ax4.set_ylabel('奖励值')\n",
    "    ax4.set_title('PPO学习曲线')\n",
    "    ax4.legend()\n",
    "    ax4.grid(True, alpha=0.3)\n",
    "    \n",
    "    plt.suptitle('PPO强化学习算法简化演示', fontsize=16, weight='bold')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    return policy, rewards\n",
    "\n",
    "policy_model, training_rewards = simple_ppo_demo()"
   ]
  },
  {
