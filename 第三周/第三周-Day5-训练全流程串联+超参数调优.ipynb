   "source": [
    "## ⚡ 早停法实现\n",
    "\n",
    "早停法是防止过拟合的重要技术，让我们实现一个简单的早停法："
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "def early_stopping_demo():\n",
    "    \"\"\"演示早停法的作用\"\"\"\n",
    "    \n",
    "    # 创建容易过拟合的数据\n",
    "    np.random.seed(42)\n",
    "    X = np.random.randn(100)\n",
    "    y = 2 * X**3 + 3 * X**2 + X + 0.1 * np.random.randn(100)\n",
    "    X = X.reshape(-1, 1)\n",
    "\n",
    "    # 分割数据\n",
    "    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)\n",
    "    \n",
    "    # 训练模型并监控验证误差\n",
    "    epochs = 50\n",
    "    train_errors = []\n",
    "    val_errors = []\n",
    "    best_val_error = float('inf')\n",
    "    patience = 5\n",
    "    no_improvement = 0\n",
    "    \n",
    "    print(\"🎯 开始训练并监控...\")\n",
    "    \n",
    "    for epoch in range(epochs):\n",
    "        # 这里我们用一个多项式回归来模拟过拟合\n",
    "        # 随着epoch增加，模型会逐渐过拟合\n",
    "        complexity = min(epoch + 1, 10)  # 模拟模型复杂度增加\n",
    "        \n",
    "        # 简化的训练过程\n",
    "        poly_features = np.power(X_train, range(complexity + 1))\n",
    "        poly_test = np.power(X_test, range(complexity + 1))\n",
    "        \n",
    "        # 最小二乘法\n",
    "        weights = np.linalg.lstsq(poly_features, y_train, rcond=None)[0]\n",
    "        \n",
    "        # 计算误差\n",
    "        train_pred = poly_features @ weights\n",
    "        test_pred = poly_test @ weights\n",
    "        train_error = mean_squared_error(y_train, train_pred)\n",
    "        val_error = mean_squared_error(y_test, test_pred)\n",
    "        \n",
    "        train_errors.append(train_error)\n",
    "        val_errors.append(val_error)\n",
    "        \n",
    "        # 早停逻辑\n",
    "        if val_error < best_val_error:\n",
    "            best_val_error = val_error\n",
    "            no_improvement = 0\n",
    "        else:\n",
    "            no_improvement += 1\n",
    "        \n",
    "        if epoch % 5 == 0:\n",
    "            print(f\"Epoch {epoch}: 训练误差={train_error:.4f}, 验证误差={val_error:.4f}, 无改进={no_improvement}\")\n",
    "        \n",
    "        # 触发早停\n",
    "        if no_improvement >= patience:\n",
    "            print(f\"\\n⏹️ 早停! 在epoch {epoch + 1}停止，最佳epoch={epoch - no_improvement + 1}\")\n",
    "            break\n",
    "    \n",
    "    # 可视化结果\n",
    "    plt.figure(figsize=(12, 5))\n",
    "    \n",
    "    plt.subplot(1, 2, 1)\n",
    "    plt.plot(range(len(train_errors)), train_errors, 'b-', label='训练误差', linewidth=2)\n",
    "    plt.plot(range(len(val_errors)), val_errors, 'r-', label='验证误差', linewidth=2)\n",
    "    plt.axhline(y=best_val_error, color='g', linestyle='--', label=f'最佳验证误差: {best_val_error:.4f}')\n",
    "    plt.xlabel('Epoch')\n",
    "    plt.ylabel('MSE')\n",
    "    plt.title('早停法演示')\n",
    "    plt.legend()\n",
    "    plt.grid(True, alpha=0.3)\n",
    "    \n",
    "    plt.subplot(1, 2, 2)\n",
    "    plt.plot(range(len(val_errors)), val_errors, 'r-', linewidth=2)\n",
    "    plt.axvline(x=len(val_errors) - patience - 1, color='g', linestyle='--', label='早停点')\n",
    "    plt.fill_between(range(len(val_errors)), 0, val_errors, alpha=0.3, color='red')\n",
    "    plt.xlabel('Epoch')\n",
    "    plt.ylabel('验证误差')\n",
    "    plt.title('验证误差变化')\n",
    "    plt.legend()\n",
    "    plt.grid(True, alpha=0.3)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    return best_val_error, len(val_errors)\n",
    "\n",
    "best_error, epochs_used = early_stopping_demo()"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
