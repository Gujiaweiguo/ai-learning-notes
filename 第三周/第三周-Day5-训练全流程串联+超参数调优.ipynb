    "## 🎯 网格搜索与贝叶斯优化\n",
    "\n",
    "让我们实现两种常见的超参数调优方法：网格搜索和贝叶斯优化。"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "def hyperparameter_tuning_comparison():\n",
    "    \"\"\"比较网格搜索和贝叶斯优化\"\"\"\n",
    "    \n",
    "    # 创建更大的数据集用于调优演示\n",
    "    np.random.seed(42)\n",
    "    X_large = np.random.randn(200)\n",
    "    y_large = 3 * X_large**2 + 2 * X_large + 1 + 0.2 * np.random.randn(200)\n",
    "    X_large = X_large.reshape(-1, 1)\n",
    "    \n",
    "    # 分割数据\n",
    "    X_train_large, X_test_large, y_train_large, y_test_large = train_test_split(\n",
    "        X_large, y_large, test_size=0.3, random_state=42\n",
    "    )\n",
    "    \n",
    "    # 定义参数网格\n",
    "    param_grid = {\n",
    "        'alpha': [0.001, 0.01, 0.1, 1.0, 10.0],\n",
    "        'solver': ['auto', 'svd', 'cholesky', 'lsqr']\n",
    "    }\n",
    "    \n",
    "    # 网格搜索\n",
    "    print(\"🔍 执行网格搜索...\")\n",
    "    grid_search = GridSearchCV(\n",
    "        Ridge(), \n",
    "        param_grid, \n",
    "        cv=5,\n",
    "        scoring='neg_mean_squared_error',\n",
    "        n_jobs=-1\n",
    "    )\n",
    "    grid_search.fit(X_train_large, y_train_large)\n",
    "    \n",
    "    print(f\"网格搜索最佳参数: {grid_search.best_params_}\")\n",
    "    print(f\"网格搜索最佳得分: {-grid_search.best_score_:.4f}\")\n",
    "    \n",
    "    # 模拟贝叶斯优化\n",
    "    print(\"\\n🧠 模拟贝叶斯优化过程...\")\n",
    "    \n",
    "    # 贝叶斯优化会逐步探索更优解，这里我们模拟这个过程\n",
    "    trials = 10\n",
    "    best_score = float('inf')\n",
    "    best_params = None\n",
    "    \n",
    "    for i in range(trials):\n",
    "        # 随机采样参数\n", 
    "        alpha = 10**np.random.uniform(-3, 1)\n", 
    "        solver = np.random.choice(['auto', 'svd', 'cholesky', 'lsqr'])\n", 
    "        \n", 
    "        # 评估参数\n", 
    "        model = Ridge(alpha=alpha, solver=solver)\n", 
    "        model.fit(X_train_large, y_train_large)\n", 
    "        score = mean_squared_error(y_test_large, model.predict(X_test_large))\n", 
    "        \n", 
    "        # 更新最佳参数\n", 
    "        if score < best_score:\n", 
    "            best_score = score\n", 
    "            best_params = {'alpha': alpha, 'solver': solver}\n", 
    "        \n", 
    "        if i % 2 == 0:\n", 
    "            print(f\"尝试 {i+1}/{trials}: α={alpha:.4f}, {solver}, 得分={score:.4f}\")\n", 
    "    \n", 
    "    print(f\"\\n贝叶斯优化最佳参数: {best_params}\")\n", 
    "    print(f\"贝叶斯优化最佳得分: {best_score:.4f}\")\n", 
    "    \n",
    "    return grid_search, best_params, best_score\n",
    "\n",
    "grid_search, bayes_params, bayes_score = hyperparameter_tuning_comparison()"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
