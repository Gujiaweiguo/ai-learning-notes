    "    print(f\"适配器维度: {hidden_dim // 4}\")\n",
    "    print(f\"原始参数量: {input_dim * hidden_dim + hidden_dim}\")\n",
    "    print(f\"适配器参数量: {hidden_dim * (hidden_dim // 4) * 2 + (hidden_dim // 4) * 2}\")\n",
    "    print(f\"参数压缩比: {(input_dim * hidden_dim + hidden_dim) / (hidden_dim * (hidden_dim // 4) * 2)}\")\n",
    "\n",
