   "source": [
    "### QLoRA微调原理\n",
    "\n",
    "QLoRA的核心是4bit量化和双重适配器技术："
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def quantization_demo():\n",
    "    \"\"\"演示量化效果\"\"\"\n",
    "    # 生成原始权重\n",
    "    np.random.seed(42)\n",
    "    original_weights = np.random.randn(64, 64) * 10\n",
    "    \n",
    "    # 4bit量化（模拟）\n",
    "    quantized_weights = np.round(original_weights / 16) * 16\n",
    "    \n",
    "    # 计算误差\n",
    "    error = np.abs(original_weights - quantized_weights)\n",
    "    \n",
    "    # 可视化\n",
    "    fig, axes = plt.subplots(2, 2, figsize=(12, 10))\n",
    "    \n",
    "    # 原始权重\n",
    "    im1 = axes[0,0].imshow(original_weights, cmap='RdBu', aspect='auto')\n",
    "    axes[0,0].set_title('原始权重 (32bit)')\n",
    "    plt.colorbar(im1, ax=axes[0,0])\n",
    "    \n",
    "    # 量化后权重\n",
    "    im2 = axes[0,1].imshow(quantized_weights, cmap='RdBu', aspect='auto')\n",
    "    axes[0,1].set_title('4bit量化权重')\n",
    "    plt.colorbar(im2, ax=axes[0,1])\n",
    "    \n",
    "    # 量化误差\n",
    "    im3 = axes[1,0].imshow(error, cmap='Reds', aspect='auto')\n",
    "    axes[1,0].set_title('量化误差')\n",
    "    plt.colorbar(im3, ax=axes[1,0])\n",
    "    \n",
    "    # 误差分布直方图\n",
    "    axes[1,1].hist(error.flatten(), bins=30, alpha=0.7, color='red')\n",
    "    axes[1,1].set_title('误差分布')\n",
    "    axes[1,1].set_xlabel('误差值')\n",
    "    axes[1,1].set_ylabel('频次')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    # 统计信息\n",
    "    original_size = original_weights.nbytes\n",
    "    quantized_size = quantized_weights.nbytes\n",
    "    compression_ratio = original_size / quantized_size\n",
    "    mse = np.mean(error**2)\n",
    "    \n",
    "    print(f\"🎯 量化效果分析：\")\n",
    "    print(f\"原始大小: {original_size} bytes\")\n",
    "    print(f\"量化后大小: {quantized_size} bytes\")\n",
    "    print(f\"压缩比: {compression_ratio:.1f}x\")\n",
    "    print(f\"均方误差: {mse:.4f}\")\n",
    "\n",
    "# 演示双重适配器\n",
    "def adapter_simulation():\n",
    "    \"\"\"模拟双重适配器工作原理\"\"\"\n",
    "    # 原始层\n",
    "    input_dim = 64\n",
    "    hidden_dim = 32\n",
    "    \n",
    "    # 原始权重（冻结）\n",
    "    W_original = np.random.randn(input_dim, hidden_dim) * 0.1\n",
    "    b_original = np.random.randn(hidden_dim) * 0.1\n",
    "    \n",
    "    # 适配器权重（可训练）\n",
    "    W_adapter1 = np.random.randn(hidden_dim, hidden_dim // 4) * 0.01\n",
    "    b_adapter1 = np.random.randn(hidden_dim // 4) * 0.01\n",
    "    W_adapter2 = np.random.randn(hidden_dim // 4, hidden_dim) * 0.01\n",
    "    b_adapter2 = np.random.randn(hidden_dim) * 0.01\n",
    "    \n",
    "    # 测试输入\n",
    "    x = np.random.randn(1, input_dim) * 0.1\n",
    "    \n",
    "    # 原始前向传播\n",
    "    original_output = np.dot(x, W_original) + b_original\n",
    "    \n",
    "    # 适配器前向传播\n",
    "    adapter1_output = np.dot(original_output, W_adapter1) + b_adapter1\n",
    "    adapter_output = np.dot(adapter1_output, W_adapter2) + b_adapter2\n",
    "    \n",
    "    print(f\"🎯 双重适配器结构：\")\n",
    "    print(f\"输入维度: {input_dim}\")\n",
