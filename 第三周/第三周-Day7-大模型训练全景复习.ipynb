    "def visualize_training_pipeline():\n",
    "    \"\"\"可视化训练流程\"\"\"\n",
    "    stages = ['数据收集', '数据清洗', '预训练', 'SFT', 'RLHF', '对齐', '推理']\n",
    "    colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4', '#FFEAA7', '#DDA0DD', '#98D8C8']\n",
    "    \n",
    "    # 计算每个阶段的资源消耗（模拟数据）\n",
    "    data_size = [100, 80, 60, 40, 30, 20, 15]  # 相对数据量\n",
    "    compute_cost = [10, 8, 50, 30, 25, 15, 5]   # 相对计算成本\n",
    "    \n",
    "    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 6))\n",
    "    \n",
    "    # 数据量变化\n",
    "    bars1 = ax1.bar(stages, data_size, color=colors, alpha=0.7)\n",
    "    ax1.set_title('训练流程中的数据量变化', fontsize=14, fontweight='bold')\n",
    "    ax1.set_ylabel('相对数据量')\n",
    "    ax1.set_xlabel('训练阶段')\n",
    "    ax1.tick_params(axis='x', rotation=45)\n",
    "    \n",
    "    # 添加数值标签\n",
    "    for bar in bars1:\n",
    "        height = bar.get_height()\n",
    "        ax1.text(bar.get_x() + bar.get_width()/2., height,\n",
    "                f'{height}', ha='center', va='bottom')\n",
    "    \n",
    "    # 计算成本\n",
    "    bars2 = ax2.bar(stages, compute_cost, color=colors, alpha=0.7)\n",
    "    ax2.set_title('各阶段计算成本', fontsize=14, fontweight='bold')\n",
    "    ax2.set_ylabel('相对计算成本')\n",
    "    ax2.set_xlabel('训练阶段')\n",
    "    ax2.tick_params(axis='x', rotation=45)\n",
    "    \n",
    "    # 添加数值标签\n",
    "    for bar in bars2:\n",
    "        height = bar.get_height()\n",
    "        ax2.text(bar.get_x() + bar.get_width()/2., height,\n",
    "                f'{height}', ha='center', va='bottom')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# 训练流程对比\n",
    "def compare_training_methods():\n",
    "    \"\"\"对比不同训练方法\"\"\"\n",
    "    methods = ['基础预训练', 'SFT微调', 'RLHF', 'DPO', 'QLoRA']\n",
    "    cost = [100, 30, 50, 25, 10]  # 相对成本\n",
    "    quality = [60, 80, 90, 85, 75]  # 相对质量\n",
    "    \n",
    "    plt.figure(figsize=(10, 6))\n",
    "    \n",
    "    # 绘制散点图\n",
    "    colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4', '#FFEAA7']\n",
    "    for i, (method, c, q) in enumerate(zip(methods, colors, cost)):\n",
    "        plt.scatter(c, q, s=200, c=c, alpha=0.7, label=method)\n",
    "        plt.annotate(method, (c, q), xytext=(5, 5), textcoords='offset points', fontsize=9)\n",
    "    \n",
    "    plt.xlabel('训练成本')\n",
    "    plt.ylabel('模型质量')\n",
    "    plt.title('训练方法：成本 vs 质量')\n",
    "    plt.grid(True, alpha=0.3)\n",
    "    plt.legend()\n",
    "    plt.show()\n",
    "\n",
    "# 可视化训练流程\n",
    "visualize_training_pipeline()\n",
