    "\n",
    "print(\"🏗️ 训练流程总结：\")\n",
    "print(\"1. 预训练：海量数据建立基础能力\")\n",
    "print(\"2. SFT：指令微调，学会遵循指令\")\n",
    "print(\"3. RLHF：人类反馈对齐价值观\")\n",
    "print(\"4. DPO：直接偏好优化，更简洁的对齐方法\")\n",
    "print(\"5. QLoRA：4bit量化微调，降低成本\")"
   ]
