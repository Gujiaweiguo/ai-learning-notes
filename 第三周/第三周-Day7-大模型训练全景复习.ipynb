    "## 🎯 W1回顾：Transformer核心机制\n",
    "\n",
    "### 自注意力机制可视化\n",
    "\n",
    "自注意力的核心公式：\n",
    "\n",
    "$$\\text{Attention}(Q, K, V) = \\text{softmax}\\left(\\frac{QK^T}{\\sqrt{d_k}}\\right)V$$\n",
    "\n",
    "让我们用NumPy实现一个简单的自注意力机制："
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def self_attention(Q, K, V, d_k):\n",
    "    \"\"\"实现自注意力机制\"\"\"\n",
    "    # 计算注意力分数\n",
    "    scores = np.dot(Q, K.T) / np.sqrt(d_k)\n",
    "    \n",
    "    # Softmax归一化\n",
    "    attention_weights = np.exp(scores) / np.sum(np.exp(scores), axis=1, keepdims=True)\n",
    "    \n",
    "    # 加权求和\n",
    "    output = np.dot(attention_weights, V)\n",
    "    \n",
    "    return output, attention_weights\n",
    "\n",
    "# 示例：3个token，每个4维\n",
    "np.random.seed(42)\n",
    "d_k = 4\n",
    "Q = np.random.randn(3, d_k)  # 查询\n",
    "K = np.random.randn(3, d_k)  # 键\n",
    "V = np.random.randn(3, d_k)  # 值\n",
    "\n",
    "output, weights = self_attention(Q, K, V, d_k)\n",
    "\n",
    "print(\"🔍 自注意力结果：\")\n",
    "print(\"注意力权重矩阵:\")\n",
    "print(np.round(weights, 3))\n",
    "print(\"\\n输出矩阵:\")\n",
    "print(np.round(output, 3))\n",
    "\n",
    "# 可视化注意力权重\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.heatmap(weights, annot=True, cmap='Blues', xticklabels=['Token1', 'Token2', 'Token3'], \n",
    "            yticklabels=['Token1', 'Token2', 'Token3'])\n",
    "plt.title('自注意力权重矩阵')\n",
    "plt.xlabel('目标Token')\n",
    "plt.ylabel('查询Token')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 多头注意力机制\n",
    "\n",
    "多头注意力将Q、K、V投影到多个子空间，并行计算注意力："
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def multi_head_attention(Q, K, V, d_model, n_heads=2):\n",
    "    \"\"\"实现多头注意力\"\"\"\n",
    "    d_k = d_model // n_heads\n",
    "    \n",
    "    # 线性投影\n",
    "    W_Q = np.random.randn(d_model, d_model)\n",
    "    W_K = np.random.randn(d_model, d_model)\n",
    "    W_V = np.random.randn(d_model, d_model)\n",
    "    W_O = np.random.randn(d_model, d_model)\n",
    "    \n",
    "    # 投影到多个头\n",
    "    Q_multi = np.dot(Q, W_Q)\n",
    "    K_multi = np.dot(K, W_K)\n",
    "    V_multi = np.dot(V, W_V)\n",
    "    \n",
    "    # 分割成多个头\n",
    "    heads = []\n",
    "    for i in range(n_heads):\n",
    "        Q_head = Q_multi[:, i*d_k:(i+1)*d_k]\n",
    "        K_head = K_multi[:, i*d_k:(i+1)*d_k]\n",
    "        V_head = V_multi[:, i*d_k:(i+1)*d_k]\n",
    "        \n",
    "        head_output, _ = self_attention(Q_head, K_head, V_head, d_k)\n",
    "        heads.append(head_output)\n",
    "    \n",
    "    # 合并多头输出\n",
    "    concatenated = np.concatenate(heads, axis=1)\n",
    "    output = np.dot(concatenated, W_O)\n",
    "    \n",
    "    return output\n",
    "\n",
    "# 测试多头注意力\n",
    "d_model = 8\n",
    "n_heads = 2\n",
    "Q_multi = np.random.randn(3, d_model)\n",
    "K_multi = np.random.randn(3, d_model)\n",
    "V_multi = np.random.randn(3, d_model)\n",
    "\n",
    "multi_head_output = multi_head_attention(Q_multi, K_multi, V_multi, d_model, n_heads)\n",
    "\n",
    "print(f\"🎯 多头注意力输出形状: {multi_head_output.shape}\")\n",
    "print(\"输出矩阵:\")\n",
    "print(np.round(multi_head_output, 3))\n",
    "\n",
    "# 可视化多头注意力概念\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "\n",
    "# 单头注意力\n",
    "single_head = np.dot(Q, K.T) / np.sqrt(d_k)\n",
    "sns.heatmap(single_head, ax=axes[0], cmap='Blues', annot=True)\n",
    "axes[0].set_title('单头注意力')\n",
    "\n",
    "# 多头注意力概念\n",
    "head_concept = np.array([[1, 0, 0.5], [0.5, 1, 0], [0, 0.5, 1]])\n",
    "sns.heatmap(head_concept, ax=axes[1], cmap='Blues', annot=True)\n",
    "axes[1].set_title('多头注意力：不同关注点')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
