   "source": [
    "## 🚀 W2回顾：Transformer深入理解\n",
    "\n",
    "### 位置编码对比：RoPE vs ALiBi\n",
    "\n",
    "RoPE（旋转位置编码）和ALiBi（Attention with Linear Biases）是两种重要的位置编码方法："
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def rope_position_encoding(seq_len, d_model):\n",
    "    \"\"\"RoPE位置编码\"\"\"\n",
    "    positions = np.arange(seq_len)[:, np.newaxis]\n",
    "    div_term = np.exp(np.arange(0, d_model, 2) * (-np.log(10000.0) / d_model))\n",
    "    \n",
    "    pe = np.zeros((seq_len, d_model))\n",
    "    pe[:, 0::2] = np.sin(positions * div_term)\n",
    "    pe[:, 1::2] = np.cos(positions * div_term)\n",
    "    \n",
    "    return pe\n",
    "\n",
    "def alibi_attention_bias(seq_len, num_heads, dtype=np.float32):\n",
    \"\"\"ALiBi注意力偏置\"\"\"\n",
    "    slopes = np.power(2.0, -8.0 / num_heads)\n",
    "    \n",
    "    # 创建距离矩阵\n",
    "    distance = np.arange(seq_len)[:, np.newaxis] - np.arange(seq_len)[np.newaxis, :]\n",
    "    distance = distance.astype(dtype)\n",
    "    \n",
    "    # 应用斜率\n",
    "    bias = -slopes[:, np.newaxis, np.newaxis] * np.abs(distance)\n",
    "    \n",
    "    return bias\n",
    "\n",
    "# 可视化位置编码\n",
    "seq_len = 10\n",
    "d_model = 8\n",
    "num_heads = 2\n",
    "\n",
    "rope_pe = rope_position_encoding(seq_len, d_model)\n",
    "alibi_bias = alibi_attention_bias(seq_len, num_heads)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "\n",
    "# RoPE可视化\n",
    "sns.heatmap(rope_pe, ax=axes[0], cmap='RdBu', center=0)\n",
    "axes[0].set_title('RoPE位置编码')\n",
    "axes[0].set_xlabel('维度')\n",
    "axes[0].set_ylabel('位置')\n",
    "\n",
    "# ALiBi偏置可视化\n",
    "sns.heatmap(alibi_bias[0], ax=axes[1], cmap='RdBu', center=0)\n",
    "axes[1].set_title('ALiBi注意力偏置(Head 1)')\n",
    "axes[1].set_xlabel('目标位置')\n",
    "axes[1].set_ylabel('查询位置')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"🎯 位置编码对比：\")\n",
    "print(\"RoPE: 用三角函数编码位置信息，支持相对位置\")\n",
    "print(\"ALiBi: 用线性偏置，计算更高效，不支持相对位置\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 推理优化技术\n",
    "\n",
    "KV Cache、Flash Attention、GQA等推理优化技术："
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def kv_cache_simulation(tokens, cache_size=3):\n",
    "    \"\"\"模拟KV Cache工作原理\"\"\"\n",
    "    cache = {}\n",
    "    attention_scores = []\n",
    "    \n",
    "    for i, token in enumerate(tokens):\n",
    "        if i < cache_size:\n",
    "            # 新token，需要计算完整注意力\n",
    "            scores = np.random.rand(i+1)\n",
    "            cache[f\"token_{i}\"] = scores\n",
    "            attention_scores.append(scores)\n",
    "            print(f\"Token {i}: 计算完整注意力 (缓存大小: {len(cache)})\")\n",
    "        else:\n",
    "            # 使用缓存\n",
    "            cached_scores = cache[f\"token_{cache_size-1}\"]\n",
    "            new_scores = np.append(cached_scores, [1.0])  # 新token获得最高权重\n",
    "            attention_scores.append(new_scores)\n",
    "            print(f\"Token {i}: 使用KV Cache (跳过重复计算)\")\n",
    "    \n",
    "    return attention_scores\n",
    "\n",
    "# 模拟推理过程\n",
    "tokens = [\"hello\", \"world\", \"how\", \"are\", \"you\", \"today\"]\n",
    "attention_patterns = kv_cache_simulation(tokens, cache_size=2)\n",
    "\n",
    "# 可视化KV Cache效果\n",
    "plt.figure(figsize=(10, 6))\n",
    "for i, pattern in enumerate(attention_patterns):\n",
    "    plt.plot(pattern, 'o-', label=f'Token {i} (\"{tokens[i]}\")')\n",
    "\n",
    "plt.title('KV Cache注意力模式')\n",
    "plt.xlabel('历史Token位置')\n",
    "plt.ylabel('注意力分数')\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.show()\n",
    "\n",
    "print(\"⚡ 推理优化技术总结：\")\n",
    "print(\"1. KV Cache: 缓存Key-Value对，避免重复计算\")\n",
    "print(\"2. Flash Attention: 分块计算，减少内存访问\")\n",
    "print(\"3. GQA: 多查询注意力，平衡质量和效率\")\n",
    "print(\"4. Paged Attention: 虚拟内存管理，优化内存使用\")"
   ]
  },
  {
